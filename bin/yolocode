#!/usr/bin/env bash

set -euo pipefail

YOLOCODE_CONFIG='{"permissions":[{"action":"*","resource":"*","effect":"allow"},{"action":"shell","resource":"rm *","effect":"deny"},{"action":"shell","resource":"git push *","effect":"deny"},{"action":"shell","resource":"gh push *","effect":"deny"}]}'

if command -v opencode2 >/dev/null 2>&1; then
  OPENCODE_BIN="$(command -v opencode2)"
elif [ -x "$HOME/.opencode/bin/opencode2" ]; then
  OPENCODE_BIN="$HOME/.opencode/bin/opencode2"
else
  printf 'yolocode: could not find opencode2 in PATH or at %s\n' "$HOME/.opencode/bin/opencode2" >&2
  exit 1
fi

exec env OPENCODE_CONFIG_CONTENT="$YOLOCODE_CONFIG" "$OPENCODE_BIN" --standalone "$@"
