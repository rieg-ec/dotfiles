{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./plugins/reviewer.ts",
    "opencode-claude-auth@latest",
  ],
  "agent": {
    "build": {
      "enable1mContext": true
    }
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {}
    }
  },
  "mode": {
    "build": {
      "prompt": "You are Claude Code, Anthropic's official CLI for Claude."
    },
    "plan": {
      "prompt": "You are Claude Code, Anthropic's official CLI for Claude."
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "ls": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "cat *": "allow",
      "cat": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "which *": "allow",
      "whereis *": "allow",
      "type *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "hostname": "allow",
      "date *": "allow",
      "date": "allow",
      "uname *": "allow",
      "df *": "allow",
      "du *": "allow",
      "tree *": "allow",
      "diff *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "stat *": "allow",
      "env": "allow",
      "printenv *": "allow",
      "git status *": "allow",
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git diff": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git branch": "allow",
      "git remote *": "allow",
      "git fetch *": "allow",
      "git stash list *": "allow",
      "git stash list": "allow",
      "git tag *": "allow",
      "git tag": "allow",
      "git rev-parse *": "allow",
      "git config --get *": "allow",
      "git config --list *": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git blame *": "allow",
      "git shortlog *": "allow",
      "git describe *": "allow",
      "git reflog *": "allow",
      "git cherry *": "allow",
      "git rev-list *": "allow",
      "git cat-file *": "allow",
      "git name-rev *": "allow",
      "gh auth status *": "allow",
      "gh auth status": "allow",
      "gh repo view *": "allow",
      "gh repo list *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh pr view*": "allow",
      "gh pr status *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh issue status *": "allow",
      "gh release list *": "allow",
      "gh release view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh workflow list *": "allow",
      "gh workflow view *": "allow",
      "gh gist list *": "allow",
      "gh gist view *": "allow",
      "gh search *": "allow",
      "gh label list *": "allow",
      "gh project list *": "allow",
      "gh project view *": "allow",
      "gh config list *": "allow",
      "gh config get *": "allow",
      "gh extension list *": "allow",
      "gh api *": "allow",
      "gh api *--method POST*": "ask",
      "gh api *--method PATCH*": "ask",
      "gh api *--method PUT*": "ask",
      "gh api *--method DELETE*": "ask",
      "gh api *-X POST*": "ask",
      "gh api *-X PATCH*": "ask",
      "gh api *-X PUT*": "ask",
      "gh api *-X DELETE*": "ask",
      "bin/lint *": "allow",
      "bundle exec rspec *": "allow",
      "npx tsc *": "allow",
      "yarn lint *": "allow",
      "yarn typecheck *": "allow"
    },
    "edit": {
      "*": "ask"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "skill": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "external_directory": "allow",
    "review": "ask"
  }
}
