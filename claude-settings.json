  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-session-id-hook",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "Notion@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true
